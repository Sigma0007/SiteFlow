rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access for authenticated users with specific email
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // More specific rules for better debugging
    match /sites/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /labour/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /attendance/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /buildings/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /materials/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /purchaseOrders/{document} {
      allow read, write: if request.auth != null;
    }
    
    match /processes/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
