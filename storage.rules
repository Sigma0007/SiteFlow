rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images can be uploaded by authenticated users
    match /images/{userId}/{allPaths=**} {
      allow read: if true; // Anyone can read images
      allow write: if request.auth != null && request.auth.uid == userId; // Only owner can upload
    }
    
    // Site images
    match /sites/{siteId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Building images  
    match /buildings/{buildingId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Process images
    match /processes/{processId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Profile pictures
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
